rules_version = '2';

// Access model
// - A consultant's workspace lives at /consultants/{uid} (head) plus one record per item in
//   /consultants/{uid}/{list}/{id} for the lists that grow. Only that signed-in user can touch them,
//   and only once the server has approved the account (sign-up mode and invites).
// - Older builds also wrote copies keyed by email (/consultants/{email}, /consultants_by_email/{email}).
//   Those are readable (never writable) by the owner of that verified email so the app can import them once.
// - Flat /documents and /support_messages rows carry consultantId and are scoped to it.
// - Client portal credentials, tokens and mail queues are server-only (Firebase Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUid(id) {
      return signedIn() && request.auth.uid == id;
    }

    function isVerifiedEmail(email) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email.lower();
    }

    function ownsId(id) {
      return isUid(id) || isVerifiedEmail(id);
    }

    // Team and accountant access (server/team.ts). Only the server writes workspace_members.
    function membership(ownerId) {
      return /databases/$(database)/documents/workspace_members/$(ownerId + '_' + request.auth.uid);
    }
    function isMember(ownerId) {
      return signedIn() && ownerId is string && exists(membership(ownerId));
    }
    function isEditor(ownerId) {
      return isMember(ownerId) && get(membership(ownerId)).data.role == 'editor';
    }

    // A workspace can be created only by an account the server approved (account_access/{uid},
    // written by POST /api/account/register under the sign-up mode), or one that already has a
    // workspace (everyone who signed up before this check).
    function approved(uid) {
      return exists(/databases/$(database)/documents/account_access/$(uid))
        || exists(/databases/$(database)/documents/consultants/$(uid));
    }

    match /consultants/{docId} {
      allow read: if ownsId(docId) || isMember(docId);
      allow update, delete: if isUid(docId);
      // Someone the owner made an editor keeps the books, but can't change whose books they are.
      allow update: if isEditor(docId) && request.resource.data.consultantEmail == resource.data.consultantEmail;
      allow create: if isUid(docId) && exists(/databases/$(database)/documents/account_access/$(docId));

      // Keep in step with SPLIT_LISTS in src/lib/workspaceRecords.ts.
      match /{list}/{recordId} {
        allow read, write: if isUid(docId) && approved(docId) && list in [
          'businesses', 'clients', 'services', 'projects', 'documents', 'expenses',
          'transactions', 'activityLogs', 'aiConversations', 'aiMemories', 'payRuns', 'suppliers'
        ];
        // Team members see and (editors) keep the books, but not the owner's AI assistant chats.
        // Keep in step with SHARED_LISTS in src/lib/workspaceRecords.ts.
        allow read: if isMember(docId) && list in [
          'businesses', 'clients', 'services', 'projects', 'documents', 'expenses',
          'transactions', 'activityLogs', 'payRuns', 'suppliers'
        ];
        allow write: if isEditor(docId) && list in [
          'businesses', 'clients', 'services', 'projects', 'documents', 'expenses',
          'transactions', 'activityLogs', 'payRuns', 'suppliers'
        ];
      }
    }

    match /consultants_by_email/{email} {
      allow read: if isVerifiedEmail(email);
      allow write: if false;
    }

    match /documents/{documentId} {
      allow read: if signedIn() && (ownsId(resource.data.consultantId) || isMember(resource.data.consultantId));
      allow create: if signedIn() && (request.resource.data.consultantId == request.auth.uid || isEditor(request.resource.data.consultantId));
      allow update: if signedIn() && (
        (ownsId(resource.data.consultantId) && request.resource.data.consultantId == request.auth.uid)
        || (isEditor(resource.data.consultantId) && request.resource.data.consultantId == resource.data.consultantId));
      allow delete: if signedIn() && (ownsId(resource.data.consultantId) || isEditor(resource.data.consultantId));
    }

    match /workspace_members/{id} {
      allow read, write: if false;
    }
    match /team_invites/{id} {
      allow read, write: if false;
    }

    match /support_messages/{messageId} {
      allow read: if signedIn() && ownsId(resource.data.consultantId);
      allow create: if signedIn()
        && request.resource.data.consultantId == request.auth.uid
        && request.resource.data.sender == 'consultant';
      allow update: if signedIn()
        && ownsId(resource.data.consultantId)
        && request.resource.data.consultantId == resource.data.consultantId;
    }

    // Everything else (clients_auth, client_tokens, mail, email_logs, test, legacy flat
    // collections) is only reachable from the server.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
