# ---- Server (Express) ----

# Port the server listens on (Cloud Run sets this automatically).
PORT=3000

# Public URL of the app, used in links inside emails.
APP_URL="https://your-app.example.com"

# Gemini API key for the AI features. Without it, the app falls back to built-in rules.
GEMINI_API_KEY=""
# Optional: comma-separated model failover lists.
# GEMINI_TEXT_MODELS="gemini-flash-latest,gemini-flash-lite-latest"
# GEMINI_VISION_MODELS="gemini-flash-latest,gemini-flash-lite-latest"

# Secret used to sign client portal sessions. Required in production: without it,
# client portal sessions end whenever the server restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SESSION_SECRET=""

# Firebase Admin credentials. On Cloud Run the service account is used automatically.
# Locally, point this at a service-account key that can read/write Firestore.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# Optional overrides (defaults come from firebase-applet-config.json):
# FIREBASE_PROJECT_ID=""
# FIRESTORE_DATABASE_ID=""

# SendGrid for sending invoices, quotes and receipts. Without it, sending email is disabled
# (the app says so instead of pretending).
SENDGRID_API_KEY=""
# Must be a sender you have verified in SendGrid. Replies go to the business email.
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="Frilensa"

# ---- Client (Vite, baked in at build time) ----

# Comma-separated emails that can open the platform admin panel.
VITE_ADMIN_EMAILS=""
